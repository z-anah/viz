<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1"
          xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.example.filtercard"
                       extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Filter Card Plugin</description>
    <author name="Developer"
            email="developer@example.com"
            organization="Personal"
            website="https://example.com"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8011/card/index.html</url>
    </source-location>
    <icon/>

    <encoding id="region">
      <display-name>Region</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>

    <encoding id="mill">
      <display-name>Mill</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">Filter Card</text>
    </resource>
  </resources>
</manifest>