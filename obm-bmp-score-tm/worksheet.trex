<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1"
          xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.primeagri.obm-bmp-score-tm"
                       extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>obm-bmp-score-tm</description>
    <author name="Prime Agri Resources"
            email="developer@example.com"
            organization="Prime Agri"
            website="https://example.com"/>
    <min-api-version>1.11</min-api-version>
    <source-location>
      <url>http://localhost:8011/obm-bmp-score-tm/index.html</url>
    </source-location>
    <icon/>

    <encoding id="bmp-score">
      <display-name>BMP Score</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>

    <encoding id="sumatra-score">
      <display-name>Sumatra Score</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>

    <encoding id="kalimantan-score">
      <display-name>Kalimantan Score</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>

    <encoding id="mom-overall">
      <display-name>MoM Overall</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>
  </worksheet-extension>

  <resources>
    <resource id="name">
      <text locale="en_US">obm-bmp-score-tm</text>
    </resource>
  </resources>
</manifest>